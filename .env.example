# Путь к отдельному checkout AsterYggdrasil, используемому Docker Compose.
ASTER_CONTEXT=../aster

# Хосты, для которых локальный HTTP-вход перенаправляется на публичный HTTPS.
LEGACY_SITE_HOSTS=127.0.0.1 localhost

# Исходящий HTTP CONNECT-прокси для наполнения локального кэша модов, если
# официальный CDN недоступен напрямую с хоста. В контейнере loopback хоста
# доступен как host.docker.internal.
MOD_CACHE_PROXY_URL=http://host.docker.internal:2080

# При старте фоново загружать отсутствующие файлы текущего модпака в кэш.
MOD_CACHE_WARM=true
