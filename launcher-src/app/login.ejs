<div id="loginContainer" style="display: none;">
    <div id="loginCancelContainer" style="display: none;">
        <button id="loginCancelButton">
            <span id="loginCancelIcon" class="krwa-icon icon-back" aria-hidden="true"></span>
            <span id="loginCancelText"><%- lang('login.loginCancelText') %></span>
        </button>
    </div>
    <div id="loginContent">
        <form id="loginForm">
            <img id="loginImageSeal" src="assets/images/krwa-wordmark.svg" alt="KRWA"/>
            <span id="loginSubheader"><%- lang('login.loginSubheader') %></span>
            <div class="krwa-auth-tabs"><span><%= native("Вход") %></span><a href="<%- lang('login.loginNeedAccountLink') %>"><%= native("Регистрация") %></a></div>
            <div class="loginFieldContainer">
                <span class="loginSVG krwa-icon icon-mail" aria-hidden="true"></span>
                <span class="loginErrorSpan" id="loginEmailError"><%- lang('login.loginEmailError') %></span>
                <input id="loginUsername" aria-label="<%= native('Логин или почта') %>" autocomplete="username" class="loginField" type="text" placeholder="<%- lang('login.loginEmailPlaceholder') %>"/>
            </div>
            <div class="loginFieldContainer">
                <span class="loginSVG krwa-icon icon-lock" aria-hidden="true"></span>
                <span class="loginErrorSpan" id="loginPasswordError"><%- lang('login.loginPasswordError') %></span>
                <input id="loginPassword" aria-label="<%= native('Пароль') %>" autocomplete="current-password" class="loginField" type="password" placeholder="<%- lang('login.loginPasswordPlaceholder') %>"/>
                <button id="loginPasswordToggle" type="button" aria-label="<%= native('Показать пароль') %>" aria-pressed="false"><span class="krwa-icon icon-eye" aria-hidden="true"></span></button>
            </div>
            <div id="loginOptions">
                <span class="loginSpanDim">
                    <a href="<%- lang('login.loginForgotPasswordLink') %>"><%- lang('login.loginForgotPasswordText') %></a>
                </span>
                <label id="checkmarkContainer">
                    <input id="loginRememberOption" type="checkbox" checked>
                    <span id="loginRememberText" class="loginSpanDim"><%- lang('login.loginRememberMeText') %></span>
                    <span class="loginCheckmark"></span>
                </label>
            </div>
            <button id="loginButton" disabled>
                <div id="loginButtonContent">
                    <%- lang('login.loginButtonText') %>
                    <svg id="loginSVG" viewBox="0 0 24.87 13.97">
                        <defs>
                            <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                        </defs>
                        <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                    </svg>
                    <div class="circle-loader">
                        <div class="checkmark draw"></div>
                    </div>
                    <!--<div class="spinningCircle" id="loginSpinner"></div>-->
                </div>
            </button>
            <div class="local-login-options">
                <button type="button" id="login-qr" class="settingsActionButton" aria-label="<%= native('Войти по QR-коду') %>" title="<%= native('Войти по QR-коду') %>">
                    <svg aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h4v4h-3M14 21v-3M21 13v2"/></svg>
                </button>
            <button type="button" class="settingsActionButton" id="login-local"><%= native("Играть без входа") %></button>
            </div>
            <div id="loginDisclaimer">
                <span class="loginSpanDim" id="loginRegisterSpan">
                    <a href="<%- lang('login.loginNeedAccountLink') %>"><%- lang('login.loginNeedAccountText') %></a>
                </span>
                <p class="loginDisclaimerText"><%- lang('login.loginPasswordDisclaimer1') %></p>
                <p class="loginDisclaimerText"><%- lang('login.loginPasswordDisclaimer2', { appName: lang('app.title') }) %></p>
            </div>
        </form>
    </div>
    <dialog id="deviceDialog" aria-labelledby="device-title">
        <h2 id="device-title"><%= native('Войти по QR-коду') %></h2>
        <p id="device-message" role="status"></p>
        <canvas id="device-qr" width="180" height="180" hidden></canvas>
        <strong id="device-code"></strong>
        <div><button type="button" id="device-retry" class="settingsActionButton" hidden><%= native('Повторить') %></button>
        <button type="button" id="device-close" class="settingsActionButton"><%= native('Назад') %></button></div>
    </dialog>
    <script src="./assets/js/scripts/login.js"></script>
    <script src="./assets/js/scripts/device-login.js"></script>
</div>
