<!DOCTYPE html>
<html lang="<%= language() %>" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link rel="stylesheet" href="./assets/css/krwa-theme.css">
    <link rel="stylesheet" href="./assets/css/krwa-account.css">
    <style>
        body {
            transition: background-image 1s ease;
            background-image: radial-gradient(circle at 50% 35%, #245867 0%, #15262e 45%, #0a1014 100%);
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.06) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="0">
    <%- include('frame') %>
    <div id="launcherLanguageControl">
        <button id="launcherLanguageButton" type="button" aria-label="Language / Язык / Język" aria-haspopup="menu" aria-expanded="false">
            <span id="launcherLanguageFlag" class="launcherLanguageFlag" data-language="auto" aria-hidden="true"></span>
        </button>
        <div id="launcherLanguageMenu" role="menu" aria-label="Language / Язык / Język" hidden>
            <button type="button" class="launcherLanguageOption" data-language="auto" role="menuitemradio" aria-checked="false">
                <span class="launcherLanguageFlag" data-language="auto" aria-hidden="true"></span><span><%= lang('app.autoLanguage') %></span>
            </button>
            <button type="button" class="launcherLanguageOption" data-language="ru_RU" role="menuitemradio" aria-checked="false">
                <span class="launcherLanguageFlag" data-language="ru_RU" aria-hidden="true"></span><span>Русский</span>
            </button>
            <button type="button" class="launcherLanguageOption" data-language="en_US" role="menuitemradio" aria-checked="false">
                <span class="launcherLanguageFlag" data-language="en_US" aria-hidden="true"></span><span>English</span>
            </button>
            <button type="button" class="launcherLanguageOption" data-language="pl_PL" role="menuitemradio" aria-checked="false">
                <span class="launcherLanguageFlag" data-language="pl_PL" aria-hidden="true"></span><span>Polski</span>
            </button>
        </div>
    </div>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('account') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/krwa-wordmark.png" alt="KRWA">
            </div>
            <div id="launcherUpdateStatus" hidden role="status" aria-live="polite">
                <p id="launcherUpdateMessage"><%= native("Проверяем обновления лаунчера…") %></p>
                <progress id="launcherUpdateProgress" max="100" aria-label="<%= native('Обновление лаунчера') %>"></progress>
                <p id="launcherUpdateDetail"></p>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/language.js"></script>
</body>
</html>
