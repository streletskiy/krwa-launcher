:8080 {
	@latest path /download/windows /download/linux /community.json
	handle @latest {
		reverse_proxy community:3001
	}
	root * /srv
	encode zstd gzip

	@mutable path *.json *.toml *.xml *.yml *.yaml
	header @mutable Cache-Control "no-cache, no-store, must-revalidate"

	@artifacts path *.jar *.zip *.exe *.AppImage
	header @artifacts Cache-Control "public, max-age=31536000, immutable"

	file_server
}

:8081 {
	@community path /download/windows /download/linux /community.json
	handle @community {
		reverse_proxy community:3001
	}
	handle /downloads/* {
		root * /srv
		file_server
	}
	handle {
		reverse_proxy auth:3000
	}
}
