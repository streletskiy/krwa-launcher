:8080 {
	@latest path /download/windows /download/linux /download/macos /community.json
	handle @latest {
		reverse_proxy community:3001
	}
	root * /srv
	encode zstd gzip

	@mutable path *.json *.toml *.xml *.yml *.yaml
	header @mutable Cache-Control "no-cache, no-store, must-revalidate"

	@artifacts path *.jar *.zip *.exe *.dmg *.AppImage
	header @artifacts Cache-Control "public, max-age=31536000, immutable"

	file_server
}

:8081 {
	@legacySite {
		host {$LEGACY_SITE_HOSTS}
		method GET HEAD
		path / /login /register /reset-password /admin /admin/* /account /account/* /tos /privacy
	}
	redir @legacySite https://mc.krwa.ru{uri} 308
	@community path /download/windows /download/linux /download/macos /community.json
	handle @community {
		reverse_proxy community:3001
	}
	@curseForgeFallback {
		method GET HEAD
		path_regexp ^/cf-files/files/[0-9]+/[0-9]+/[^/]+$
	}
	handle @curseForgeFallback {
		reverse_proxy mod-cache:3002 {
			lb_try_duration 15s
			lb_try_interval 500ms
			transport http {
				dial_timeout 5s
				response_header_timeout 180s
			}
		}
	}
	handle /cf-files/* {
		respond 404
	}
	@repository path /downloads/* /distribution.json /health.json /servers/* /repo/* /modpacks/* /pack/*
	handle @repository {
		root * /srv
		@mutable path *.json *.toml *.xml *.yml *.yaml
		header @mutable Cache-Control "no-cache, no-store, must-revalidate"
		@artifacts path *.jar *.zip *.exe *.dmg *.AppImage
		header @artifacts Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy auth:3000 {
			# NPM overwrites X-Real-IP with its TCP peer; public clients cannot set it.
			header_up X-Forwarded-For {http.request.header.X-Real-IP}
		}
	}
}
